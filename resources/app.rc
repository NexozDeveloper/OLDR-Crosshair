#include <winres.h>
#include "resource.h"
#include "oldr_version.h"

IDI_APP ICON "app.ico"

// Visual-style (common controls v6) + DPI manifest. CMake disables the linker-generated one.
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION OLDR_VER_MAJOR,OLDR_VER_MINOR,OLDR_VER_PATCH,0
 PRODUCTVERSION OLDR_VER_MAJOR,OLDR_VER_MINOR,OLDR_VER_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OLDR"
            VALUE "FileDescription", "OLDR Crosshair"
            VALUE "FileVersion", OLDR_VERSION_STRING
            VALUE "InternalName", "OLDR_Crosshair"
            VALUE "OriginalFilename", "OLDR_Crosshair.exe"
            VALUE "ProductName", "OLDR Crosshair"
            VALUE "ProductVersion", OLDR_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
